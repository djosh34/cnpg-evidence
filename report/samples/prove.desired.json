{
  "kind": "desired",
  "source": "prove",
  "namespace": "databases",
  "cluster": "pg",
  "probes": [
    {
      "probe": "password-tls",
      "expected": "refused by pg_hba reject",
      "value": "denied",
      "ok": true
    },
    {
      "probe": "password-no-tls",
      "expected": "refused by pg_hba reject",
      "value": "denied",
      "ok": true
    },
    {
      "probe": "tls-no-client-cert",
      "expected": "refused, orders to orders needs a client certificate",
      "value": "denied",
      "ok": true
    },
    {
      "probe": "replication-cert-as-orders",
      "expected": "refused, the certificate CN does not map to orders",
      "value": "denied",
      "ok": true
    },
    {
      "probe": "control-replication-cert",
      "expected": "logs in as streaming_replica to postgres (CNPG's fixed line)",
      "value": "allowed",
      "ok": true
    },
    {
      "probe": "uid-26 socket-proc-root",
      "expected": "Permission denied",
      "value": "denied",
      "ok": true
    },
    {
      "probe": "uid-26 pgdata-host-path",
      "expected": "Permission denied",
      "value": "denied",
      "ok": true
    },
    {
      "probe": "uid-mapped socket-host-path",
      "expected": "Permission denied",
      "value": "denied",
      "ok": true
    }
  ]
}
